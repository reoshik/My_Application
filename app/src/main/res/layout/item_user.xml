<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/back_smoke_round"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="#E9E1F5">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="R"
                android:textColor="#7655A6"
                android:textSize="22sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/NameTextView"
                style="@style/NameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#292333"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/StateTextView"
                style="@style/StateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#77717F"
                android:textSize="14sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/StateRound"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/back_offline" />

    </LinearLayout>

</FrameLayout>